# Copy to .env, then enter newly generated local-only values. Do not reuse production credentials.
# For an existing local volume, match its current credentials; changing these does not reset it.
NGNG_MYSQL_PASSWORD=
NGNG_MYSQL_ROOT_PASSWORD=
NGNG_MINIO_ROOT_USER=
NGNG_MINIO_ROOT_PASSWORD=
# A random Base64URL-encoded key of at least 32 bytes; see docs/LOCAL_DEVELOPMENT.md.
NGNG_JWT_SECRET=
